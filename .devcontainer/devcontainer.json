{
  "name": "Dujiao-Next Development",

  "dockerComposeFile": "docker-compose.yml",

  "service": "app",

  "workspaceFolder": "/workspaces/dujiao-next",

  "shutdownAction": "stopCompose",

  "forwardPorts": [
    8080,
    5173,
    5174
  ],

  "remoteEnv": {
    "ANTHROPIC_BASE_URL": "http://host.docker.internal:6789",
    "ANTHROPIC_AUTH_TOKEN": "magpie",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "workbuddy-ai/deepseek-v4.1-flash[1m]",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "workbuddy-ai/deepseek-v4.1-flash[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "workbuddy-ai/deepseek-v4.1-flash[1m]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "workbuddy-ai/deepseek-v4.1-flash[1m]",
    "ANTHROPIC_SMALL_FAST_MODEL": "workbuddy-ai/deepseek-v4.1-flash[1m]"
  },

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "Vue.volar",
        "ms-azuretools.vscode-docker"
      ]
    }
  },

  "postCreateCommand": "corepack enable && corepack prepare pnpm@10.34.3 --activate && go mod download",

  "postStartCommand": "bash ${containerWorkspaceFolder}/.devcontainer/start-dev.sh"
}
